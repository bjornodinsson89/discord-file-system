# Discord bot service
DISCORD_TOKEN=replace_with_bot_token
# Optional: restrict command sync to one guild during development
# GUILD_ID=
# Optional: clear old slash command registrations once
# CLEAN_COMMANDS=0

# Database
DB_HOST=localhost
DB_PORT=6543
DB_NAME=happy_jumper
DB_USER=postgres
DB_PASSWORD=postgres
# SSL mode (libpq-style):
# - disable/off/no/false/0: no TLS
# - allow/prefer/require/true/yes/on/1: TLS enabled, certificate verification OFF by default
# - verify-ca/verify-full: TLS enabled, certificate verification ON by default
# If DB_SSL is unset, sslmode from DATABASE_URL is used when present.
DB_SSL=require
# Optional explicit override for certificate verification behavior.
# NOTE: If DB_SSL is allow/prefer/require, DB_SSL_VERIFY is ignored.
# Use DB_SSL=verify-ca or DB_SSL=verify-full to enable verification safely.
# DB_SSL_VERIFY=false
# Optional custom CA bundle path for verification modes (verify-ca / verify-full).
# DB_SSL_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Optional fallback for verification failures (not usually needed for DB_SSL=require)
# DB_SSL_ALLOW_INSECURE_FALLBACK=false
# Optional max DB startup connection attempts before failing process startup (default: 20)
# DB_CONNECT_MAX_ATTEMPTS=20

# Core secret for encrypted per-user Torn API keys
FERNET_KEY=replace_with_valid_fernet_key

# DB acquire timeout in seconds (prevents hanging commands)
# DB_ACQUIRE_TIMEOUT=10
