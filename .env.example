# Discord bot service
DISCORD_TOKEN=replace_with_bot_token
# Optional: restrict command sync to one guild during development
# GUILD_ID=
# Optional: clear old slash command registrations once
# CLEAN_COMMANDS=0

# Database
DB_HOST=localhost
DB_PORT=6543
DB_NAME=happy_jumper
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=disable
# DB_SSL_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# Optional startup behavior
RUN_MIGRATIONS=1
RUN_EMERGENCY_SCHEMA_FIXES=0

# Core secret for encrypted per-user Torn API keys
FERNET_KEY=replace_with_valid_fernet_key

# Optional legacy secret used to decrypt pre-existing encrypted values
# DASHBOARD_SECRET_KEY=
