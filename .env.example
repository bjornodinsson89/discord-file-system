# Service mode: WEB for dashboard API, BOT for Discord worker
SERVICE_MODE=WEB

# Database
DB_HOST=localhost
DB_PORT=6543
DB_NAME=happy_jumper
DB_USER=postgres
DB_PASSWORD=postgres
# disable | require | verify-ca | verify-full
DB_SSL=disable

# Optional startup behavior
RUN_MIGRATIONS=0
RUN_EMERGENCY_SCHEMA_FIXES=0

# Core secrets
FERNET_KEY=replace_with_valid_fernet_key
DISCORD_TOKEN=replace_with_bot_token

# Web-only settings
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_SECRET_KEY=replace_with_random_secret
DASHBOARD_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Cookie/session overrides (optional)
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=0

# Bot-only optional settings
# GUILD_ID=
# ADMIN_ROLE_NAME=
# CLEAN_COMMANDS=0
